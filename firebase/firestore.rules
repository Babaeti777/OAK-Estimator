rules_version = '2';

/**
 * Firestore Security Rules for OAK Construction Estimator
 *
 * DEPLOYMENT INSTRUCTIONS:
 * 1. Go to Firebase Console > Firestore Database > Rules
 * 2. Copy and paste these rules
 * 3. Click "Publish"
 *
 * ALSO REQUIRED - Create Composite Index:
 * 1. Go to Firebase Console > Firestore Database > Indexes
 * 2. Click "Add Index"
 * 3. Collection ID: projects
 * 4. Field 1: userId (Ascending)
 * 5. Field 2: updatedAt (Descending)
 * 6. Query scope: Collection
 * 7. Click "Create"
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user owns this document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Projects Collection
    match /projects/{projectId} {
      // Read: User can only read their own projects
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      // Create: User can create projects with their own userId
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      // Update: User can update their own projects
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;

      // Delete: User can delete their own projects
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // User Settings Collection (for future use)
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Sync Metadata Collection (for future use)
    match /syncMetadata/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Line Item Templates Collection
    match /lineItemTemplates/{templateId} {
      // Read: User can only read their own templates
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      // Create: User can create templates with their own userId
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      // Update: User can update their own templates
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;

      // Delete: User can delete their own templates
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // Project Versions Collection
    match /projectVersions/{versionId} {
      // Read: User can only read versions of their own projects
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      // Create: User can create versions with their own userId
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      // Delete: User can delete their own versions
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // Project Folders Collection (app uses 'folders')
    match /folders/{folderId} {
      // Read: User can only read their own folders
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      // Create: User can create folders with their own userId
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      // Update: User can update their own folders
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;

      // Delete: User can delete their own folders
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // Legacy Project Folders Collection (for backwards compatibility)
    match /projectFolders/{folderId} {
      // Read: User can only read their own folders
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      // Create: User can create folders with their own userId
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      // Update: User can update their own folders
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;

      // Delete: User can delete their own folders
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // Assemblies Collection
    match /assemblies/{assemblyId} {
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // Change Orders Collection
    match /changeOrders/{changeOrderId} {
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // Labor Rates Collection
    match /laborRates/{laborRateId} {
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // Shared Projects Collection (for client portal)
    match /sharedProjects/{shareId} {
      // Owner can read/write their shares
      allow read, write: if isAuthenticated() &&
                            resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      // Public can read by token (for viewing shared estimates)
      allow read: if resource.data.shareToken != null;
    }

    // Client Comments Collection
    match /clientComments/{commentId} {
      // Anyone can create comments on shared projects
      allow create: if true;
      // Owner of the shared project can read all comments
      allow read: if true;
      // Only authenticated users can resolve comments
      allow update: if isAuthenticated();
    }

    // Attachments Collection
    match /attachments/{attachmentId} {
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // Custom Materials Collection (user-defined materials)
    match /customMaterials/{materialId} {
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // Price Overrides Collection (user price customizations)
    match /priceOverrides/{overrideId} {
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // Catalog Metadata (per-user version tracking)
    match /catalogMeta/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Shared Assemblies (community assemblies)
    match /sharedAssemblies/{assemblyId} {
      // Any authenticated user can read shared assemblies
      allow read: if isAuthenticated();
      // Only the publisher can create/update/delete
      allow create: if isAuthenticated() &&
                       request.resource.data.publishedBy == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() &&
                       resource.data.publishedBy == request.auth.uid;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
